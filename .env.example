# ─────────────────────────────────────────────────────────────
# Supabase – required for database and admin auth
# ─────────────────────────────────────────────────────────────

# Your Supabase project URL (found in Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Service Role Key – server-side only, NEVER expose to the browser
# Found in Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon / public key – safe to expose in the browser
# Found in Project Settings > API > anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─────────────────────────────────────────────────────────────
# API Base URL
# Leave empty to use Next.js built-in API routes (recommended).
# Only set this if you are running a separate Express backend.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=

# ─────────────────────────────────────────────────────────────
# Optional – Spotify Now Playing widget
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
NEXT_PUBLIC_SPOTIFY_CLIENT_SECRET=
NEXT_PUBLIC_SPOTIFY_REFRESH_TOKEN=
