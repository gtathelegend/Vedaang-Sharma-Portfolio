# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL — used for canonical URLs, sitemaps, and structured data
NEXT_PUBLIC_SITE_URL=https://vedaangsharma.dev

# Admin authorization — only this email is treated as the site administrator.
# Must match the email of your Supabase Auth account.
ADMIN_EMAIL=

# Rate limiting (contact form) — Upstash Redis REST credentials.
# Optional: if unset, an in-memory fallback limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP (contact form & resume download notifications)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com, SMTP_PASS=<app-password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portfolio <no-reply@example.com>"
SMTP_TO=vedaangsharma2006@gmail.com

# Resume Download Notification (optional overrides)
# Dedicated recipient email for resume download alerts (defaults to SMTP_TO if unset)
RESUME_NOTIFICATION_EMAIL=vedaangsharma2006@gmail.com
# Optional alternative provider: Resend API Key (re_...) or EMAIL_API_KEY
# If set, Resend will be used for resume download notifications
RESEND_API_KEY=
EMAIL_API_KEY=

# Optional: IP-API Pro key (https://ip-api.com/docs/api:json)
# If left unset, the official free tier endpoint (http://ip-api.com) is used automatically.
IP_API_KEY=

